
---
const heroImage = "/images/hero-pride.jpg";
---

<section class="hero" id="inicio">
  <div class="hero__container">

    <div class="hero__content">

      <div class="hero__eyebrow">
        <span class="hero__eyebrow-line"></span>
        <span>Ideas para un mundo donde quepamos todes</span>
      </div>

      <h1 class="hero__title">
        <span class="hero__title-line">Encendemos</span>
        <span class="hero__title-line">
          la <em>conversación.</em>
        </span>
      </h1>

      <p class="hero__description">
        Un medio independiente sobre género, derechos humanos y
        tecnología. Historias para entender el presente y diseñar
        juntos otros futuros.
      </p>

      <div class="hero__actions">
        <a href="#historias" class="hero__button">
          Explorar historias

          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M5 12h14"></path>
            <path d="m13 6 6 6-6 6"></path>
          </svg>
        </a>

        <a href="#proyecto" class="hero__secondary-link">
          Conoce el proyecto
          <span aria-hidden="true">↗</span>
        </a>
      </div>

    </div>

    <div class="hero__visual">

      <div class="hero__image-wrapper">
        <img
          src={heroImage}
          alt="Bandera de diversidad ondeando durante una manifestación"
          class="hero__image"
          fetchpriority="high"
        />
      </div>

      <div class="hero__badge">
        <span>Existir es</span>
        <span>resistir.</span>
      </div>

      <div class="hero__caption">
        <span class="hero__caption-number">01</span>
        <p>
          La diversidad no es una tendencia.
          <br />
          Es nuestra realidad.
        </p>
      </div>

    </div>

  </div>
</section>

<style>
  /* Main section */

  .hero {
    position: relative;
    overflow: hidden;
    width: 100%;
    color: var(--white);

    background: linear-gradient(
      112deg,
      #6827eb 0%,
      #7928e9 48%,
      #a02bc6 100%
    );
  }

  .hero__container {
    width: min(90rem, 100%);
    min-height: 41.5rem;
    margin-inline: auto;
    padding: 5.5rem 4rem 6rem;

    display: grid;
    grid-template-columns: 1.12fr 0.88fr;
    align-items: center;
    gap: 3rem;
  }

  /* Content */

  .hero__content {
    position: relative;
    z-index: 2;
    max-width: 43rem;
  }

  /* Eyebrow */

  .hero__eyebrow {
    display: flex;
    align-items: center;
    gap: 0.8rem;

    margin-bottom: 1.5rem;

    color: var(--lime);
    font-family: var(--font-secondary);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    line-height: 1.5;
    text-transform: uppercase;
  }

  .hero__eyebrow-line {
    width: 1.75rem;
    height: 1px;
    flex-shrink: 0;
    background: var(--lime);
  }

  /* Main title */

  .hero__title {
    display: flex;
    flex-direction: column;
    margin: 0;

    color: var(--white);
    font-family: var(--font-primary);
    font-size: clamp(4rem, 6.2vw, 6.5rem);
    font-weight: 400;
    letter-spacing: -0.085em;
    line-height: 0.93;
  }

  .hero__title-line {
    display: block;
    white-space: nowrap;
  }

  .hero__title em {
    font-family: var(--font-editorial);
    font-weight: 400;
    letter-spacing: -0.075em;
  }

  /* Description */

  .hero__description {
    max-width: 34rem;
    margin: 1.5rem 0 0;

    color: rgba(255, 253, 248, 0.85);
    font-family: var(--font-secondary);
    font-size: 1.05rem;
    font-weight: 400;
    line-height: 1.8;
  }

  /* Actions */

  .hero__actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 1.5rem;
    margin-top: 2rem;
  }

  .hero__button {
    min-height: 3.5rem;
    padding: 0.9rem 1.25rem;

    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;

    background: var(--lime);
    color: var(--ink);

    font-family: var(--font-secondary);
    font-size: 0.95rem;
    font-weight: 700;
    text-decoration: none;

    transition:
      transform 200ms ease,
      background 200ms ease;
  }

  .hero__button:hover {
    background: #e5ff83;
    transform: translateY(-3px);
  }

  .hero__button svg {
    width: 1.25rem;
    height: 1.25rem;
  }

  .hero__secondary-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;

    padding-bottom: 0.35rem;

    color: var(--white);
    font-family: var(--font-secondary);
    font-size: 0.8rem;
    font-weight: 700;
    text-decoration: none;

    border-bottom: 1px solid rgba(255, 255, 255, 0.5);
    transition: color 200ms ease;
  }

  .hero__secondary-link:hover {
    color: var(--lime);
  }

  /* Image */

  .hero__visual {
    position: relative;
    width: 100%;
    max-width: 31rem;
    justify-self: end;
    margin: 0 0 1rem;
  }

  .hero__image-wrapper {
    position: relative;
    width: 100%;
    aspect-ratio: 0.98;
    overflow: hidden;
    transform: rotate(1deg);
  }

  .hero__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  /* Lime badge */

  .hero__badge {
    position: absolute;
    z-index: 2;
    top: -1.5rem;
    right: -1.5rem;

    width: 7.5rem;
    aspect-ratio: 1;

    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;

    border-radius: 50%;
    background: var(--lime);
    color: var(--ink);

    font-family: var(--font-editorial);
    font-size: 1.05rem;
    font-style: italic;
    line-height: 1.5;

    transform: rotate(8deg);
  }

  /* Orange caption */

  .hero__caption {
    position: absolute;
    z-index: 3;
    left: -2rem;
    bottom: -2.5rem;

    width: 16.5rem;
    min-height: 3.5rem;
    padding: 0.8rem 1rem;

    display: flex;
    align-items: center;
    gap: 0.75rem;

    background: var(--orange);
    color: var(--ink);

    transform: rotate(-1.5deg);
  }

  .hero__caption-number {
    font-family: var(--font-primary);
    font-size: 0.85rem;
    font-weight: 800;
  }

  .hero__caption p {
    margin: 0;
    font-family: var(--font-secondary);
    font-size: 0.65rem;
    font-weight: 700;
    line-height: 1.35;
  }

  /* Tablet */

  @media (max-width: 1100px) {
    .hero__container {
      padding-inline: 2.5rem;
      gap: 2rem;
    }

    .hero__title {
      font-size: clamp(3.8rem, 6vw, 5rem);
    }

    .hero__visual {
      max-width: 27rem;
    }
  }

  /* Mobile */

  @media (max-width: 900px) {
    .hero {
      background: linear-gradient(
        115deg,
        #7928eb 0%,
        #9428d7 55%,
        #682be8 100%
      );
    }

    .hero__container {
      display: flex;
      flex-direction: column;
      align-items: stretch;

      min-height: auto;
      padding: 10.5rem 2rem 4.5rem;
      gap: 0;
    }

    .hero__content {
      max-width: none;
      width: 100%;
    }

    .hero__eyebrow {
      align-items: center;
      gap: 0.7rem;
      margin-bottom: 2.5rem;

      font-size: 0.9rem;
      letter-spacing: 0.13em;
      line-height: 1.6;
    }

    .hero__eyebrow-line {
      width: 2rem;
    }

    .hero__title {
      font-size: clamp(3.4rem, 11.8vw, 5rem);
      letter-spacing: -0.09em;
      line-height: 0.96;
    }

    .hero__title-line {
      white-space: normal;
    }

    .hero__description {
      max-width: none;
      margin-top: 2rem;

      font-size: 1.25rem;
      line-height: 1.7;
    }

    .hero__actions {
      flex-direction: column;
      align-items: flex-start;
      gap: 2rem;
      margin-top: 2.5rem;
    }

    .hero__button {
      min-height: 4rem;
      padding: 1rem 1.5rem;
      font-size: 1.15rem;
    }

    .hero__secondary-link {
      font-size: 1.05rem;
    }

    .hero__visual {
      display: block;
      position: relative;

      width: 100%;
      max-width: 100%;

      margin: 4rem 0 2rem;
      align-self: center;
    }

    .hero__image-wrapper {
      width: 100%;
      aspect-ratio: 1 / 1;
      overflow: hidden;
      transform: rotate(0deg);
    }

    .hero__image {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center;
    }

    .hero__badge {
      width: 6rem;
      top: -1rem;
      right: -0.5rem;
      font-size: 0.9rem;
    }

    .hero__caption {
      left: -0.5rem;
      bottom: -1.5rem;
      width: min(16.5rem, 90%);
    }
  }

  @media (max-width: 480px) {
    .hero__container {
      padding: 0.5rem 2rem 4.5rem;
    }

    .hero__content {
      order: 1;
    }

    .hero__eyebrow {
      font-size: 0.85rem;
    }

    .hero__title {
      font-size: clamp(3.2rem, 11.8vw, 4rem);
    }

    .hero__description {
      font-size: 1.2rem;
    }

    .hero__button {
      width: 100%;
      justify-content: space-between;
      padding-inline: 1.4rem;
    }
  }
</style>
