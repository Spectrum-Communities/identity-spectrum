
---
const topics = [
  "Derechos humanos",
  "Tecnología",
  "Comunidad",
  "Género",
  "Derechos humanos",
  "Tecnología",
  "Comunidad",
  "Género",
];
---

<section class="topics-marquee" aria-label="Temas de AWSPECTRUM">
  <div class="marquee-track">

    <div class="marquee-group">
      {topics.map((topic) => (
        <div class="marquee-item">
          <span>{topic}</span>
          <span class="marquee-star" aria-hidden="true">✳</span>
        </div>
      ))}
    </div>

    <div class="marquee-group" aria-hidden="true">
      {topics.map((topic) => (
        <div class="marquee-item">
          <span>{topic}</span>
          <span class="marquee-star">✳</span>
        </div>
      ))}
    </div>

  </div>
</section>

<style>
  .topics-marquee {
    width: 100%;
    height: 44px;
    overflow: hidden;
    display: flex;
    align-items: center;

    background: var(--lime);
    color: var(--ink);
  }

  .marquee-track {
    display: flex;
    width: max-content;
    flex-shrink: 0;

    animation: marquee-scroll 35s linear infinite;
    will-change: transform;
  }

  .marquee-group {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  .marquee-item {
    display: flex;
    align-items: center;
    gap: 2rem;
    padding-right: 2rem;

    white-space: nowrap;

    font-family: var(--font-secondary);
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .marquee-star {
    color: var(--purple);
    font-size: 0.9rem;
    line-height: 1;
  }

  .topics-marquee:hover .marquee-track {
    animation-play-state: paused;
  }

  @keyframes marquee-scroll {
    from {
      transform: translateX(0);
    }

    to {
      transform: translateX(-50%);
    }
  }

  @media (max-width: 768px) {
    .topics-marquee {
      height: 42px;
    }

    .marquee-item {
      gap: 1.25rem;
      padding-right: 1.25rem;
      font-size: 0.7rem;
    }

    .marquee-track {
      animation-duration: 28s;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee-track {
      animation: none;
    }

    .marquee-group[aria-hidden="true"] {
      display: none;
    }
  }
</style>
